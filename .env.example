# .env.example file - Template for environment configuration
#
# Bot configurations (API keys, secrets, trading pairs, etc.) are managed
# via YAML files in bot_configs/crypto/ and bot_configs/stock/.
# See the .yaml.example files in those directories for templates.
#
# IMPORTANT: Inline comments (on the same line as values) MUST have a space before the #
# Correct:   MYVAR="value" # This is a comment
# Incorrect: MYVAR="value"# This will include # in the value
# Best practice: Put comments on separate lines above the configuration

############################################################
# Dashboard Authentication Configuration
# Credentials for accessing the web dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme  # IMPORTANT: Generate a strong password with: openssl rand -base64 32
# Session secret key for encrypting session cookies (auto-generated if not set)
# When left empty a random key is generated at startup, so every restart signs
# everyone out. Set it to keep sessions across restarts.
SESSION_SECRET_KEY=  # Optional: Generate with: openssl rand -base64 32
# Mark the session cookie Secure so browsers never send it over plain HTTP. Works
# behind a TLS-terminating proxy: the flag reflects the browser's connection, not
# Tradleware's. With this on you cannot sign in over http:// — use HTTPS, or use
# TRUSTED_IPS for local access. Set false only for LAN-only setups with no TLS.
SESSION_HTTPS_ONLY=true
# How long a signed-in session lasts, in seconds (default 43200 = 12 hours).
# Sessions are signed cookies with no server-side store, so logging out cannot revoke
# a cookie that was already copied — a shorter lifetime is the only bound on that.
SESSION_MAX_AGE_S=43200
# Trusted IPs that bypass authentication (comma-separated, useful for local Raspberry Pi displays)
# Example: TRUSTED_IPS=192.168.1.100,192.168.1.50
# Use the address Tradleware actually sees, shown in the dashboard footer. Traffic from
# the Docker host (a kiosk browser, Home Assistant embedding the dashboard) arrives from
# the Docker network's gateway, NOT the container's own IP. Docker can reassign that
# gateway when networks are recreated — see the ipam note in docker-compose.yml to pin it.
TRUSTED_IPS=127.0.0.1
# Reverse proxies allowed to report the client IP (comma-separated IPs or CIDR blocks).
# Leave EMPTY unless Tradleware runs behind a reverse proxy or tunnel (nginx, Caddy,
# Traefik, Cloudflare Tunnel). Only requests coming from these addresses have their
# X-Forwarded-For / X-Real-IP / X-Forwarded-Proto headers honoured — for everyone else
# the real TCP connection address is used, so nobody can claim a trusted IP by sending
# a header. Set this to the address Tradleware sees the proxy connect from (for Docker,
# the proxy container's IP or its bridge subnet), never to a range you do not control.
# Example: TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

############################################################
# General Logging Configuration
# LOG_LEVEL controls what gets written to log files and console.
# Set to 10=DEBUG, 20=INFO, 25=SUCCESS, 30=WARNING, 40=ERROR, 50=CRITICAL
# Example: LOG_LEVEL=30  # Only WARNING and above will be logged
LOG_LEVEL=10
# Log file rotation. The container has no external log rotation, so the file is capped
# here: once it reaches LOG_MAX_BYTES it rolls over, keeping LOG_BACKUP_COUNT older
# files. Defaults give a ~60 MB ceiling (10 MB x 6 files) — worth lowering on a small
# Raspberry Pi SD card, especially with LOG_LEVEL=10 (DEBUG), which is verbose.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Gzip rotated files (tradleware.log.1.gz). Log text compresses ~8x, so the default
# ceiling drops from ~60 MB to ~16 MB. The active log stays uncompressed for tailing;
# read the rotated ones with zcat / zless / zgrep. Set false to keep them plain text.
LOG_COMPRESS_ROTATED=true

############################################################
# Web UI Configuration
# Set the refresh interval for log polling in milliseconds (default: 5000ms = 5 seconds)
LOG_REFRESH_INTERVAL_MS=5000

# Webhook Security Configuration
# Set a custom webhook path to protect against automated bot scans
# Default: 'webhook' (accessible at /webhook)
# Recommended: Use a random string like 'x7f9k2m4p8' (accessible at /x7f9k2m4p8)
WEBHOOK_PATH=webhook  # Example: WEBHOOK_PATH=my-secret-path-abc123

# Trade Execution Serialisation
# Each bot executes one operation at a time: a webhook signal and a dashboard fiat
# conversion for the same bot cannot overlap, so neither can size an order from a
# balance the other is about to spend. Different bots still run in parallel.
# How long a request waits for the bot to become free before giving up with HTTP 503.
# Must comfortably exceed a normal order round-trip (IBKR polls for fills, so it is
# the slow case).
TRADER_LOCK_TIMEOUT_S=60

# Webhook Transport Security
# The bot's api_key travels inside the webhook body, so a cleartext delivery hands a
# working trading credential to anyone on the network path. Webhooks are therefore
# refused unless they arrived over TLS.
# Tradleware does not terminate TLS itself, so this means: put it behind a
# TLS-terminating proxy (nginx, Caddy, Traefik, Cloudflare Tunnel) and set
# TRUSTED_PROXIES above to the address that proxy connects from. Without
# TRUSTED_PROXIES the proxy's X-Forwarded-Proto header is not believed and every
# webhook is rejected.
# Set to false ONLY when the signal source runs on this host or a trusted LAN and no
# TLS is possible — the API key then crosses the network in the clear.
WEBHOOK_REQUIRE_HTTPS=true

# Webhook Rejection Reporting
# Every rejected webhook used to write a log line and push a Gotify notification, both
# unbounded and both drivable by anyone who knows the webhook path. Because the log file
# rotates on size, a flood also EVICTED real history — at 100 requests/second the whole
# retained log was overwritten in about an hour, taking the evidence with it.
# The first occurrence of each distinct problem is still reported immediately, so nothing
# is hidden; repeats are counted and collapsed into one summary line this often.
WEBHOOK_REJECTION_SUMMARY_S=300

# Webhook Guessing Throttle
# The webhook key is free-form text and the endpoint answers a guess as fast as it
# arrives, so a one-million-word list is a couple of hours' work. After this many failed
# authentications from one address inside the window, that address stops being answered
# and gets HTTP 429 with a Retry-After. 20 per minute is far above anything a
# misconfigured alert produces and turns that word list from hours into weeks.
#
# Counted per source address, so an attacker cannot aim it at your bots — only at their
# own address. A successful signal clears that address immediately. Loopback and
# TRUSTED_IPS are never throttled, so a local script or the kiosk cannot lock itself out.
# Note the trade-off: once an address is over the limit it is refused before its key is
# checked, so a valid signal from that same address also waits out the window. Checking
# the key first would remove the protection entirely.
WEBHOOK_FAILURE_LIMIT=20
WEBHOOK_FAILURE_WINDOW_S=60

# Webhook Replay Protection
# A webhook authenticates with the api_key carried inside its body, so a captured
# request would otherwise be replayable forever, placing a real order every time.
# Signals must therefore carry a current timestamp, and an identical request body is
# never accepted twice.
#
# How far the signal's timestamp may be from this host's clock, in seconds, in either
# direction. Shorter is safer. Values below 30 are raised to 30, because ordinary
# clock drift would start rejecting valid signals.
# Requires an accurate host clock (timezone does not matter, accuracy does). On a
# Raspberry Pi especially: sudo timedatectl set-ntp true
# TradingView alerts must send {{timenow}} (the alert time), NOT {{time}} (the bar
# time) — bar time is already hours old on higher timeframes and will be rejected.
WEBHOOK_MAX_AGE_S=300
# Where accepted signals are remembered, so a restart cannot reopen the replay window.
# Defaults into the logs directory, the only path docker-compose persists.
# WEBHOOK_REPLAY_DB=/app/src/logs/webhook_replay.json

############################################################
# IBKR Health Check Configuration
# Interval (in seconds) between automatic IBKR gateway liveness probes.
# A Gotify notification is sent when a connection drops or is restored.
# Default: 60 seconds
IBKR_HEALTH_CHECK_INTERVAL_S=1800

##############################################################
# Gotify Notification Configuration
# Set these to enable real-time notifications for SUCCESS, WARNING, ERROR events
GOTIFY_SERVER_URL=https://your-gotify-server.com
GOTIFY_APP_TOKEN=your_gotify_app_token
# Default to WARNING level; adjust as needed (10=DEBUG, 20=INFO, 30=SUCCESS/WARNING, 40=ERROR, 50=CRITICAL)
GOTIFY_LOG_LEVEL=30

