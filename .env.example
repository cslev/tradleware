# .env.example file - Template for environment configuration
#
# Bot configurations (API keys, secrets, trading pairs, etc.) are managed
# via YAML files in bot_configs/crypto/ and bot_configs/stock/.
# See the .yaml.example files in those directories for templates.
#
# IMPORTANT: Inline comments (on the same line as values) MUST have a space before the #
# Correct:   MYVAR="value" # This is a comment
# Incorrect: MYVAR="value"# This will include # in the value
# Best practice: Put comments on separate lines above the configuration

############################################################
# Dashboard Authentication Configuration
# Credentials for accessing the web dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme  # IMPORTANT: Generate a strong password with: openssl rand -base64 32
# Session secret key for encrypting session cookies (auto-generated if not set)
SESSION_SECRET_KEY=  # Optional: Generate with: openssl rand -base64 32
# Trusted IPs that bypass authentication (comma-separated, useful for local Raspberry Pi displays)
# Example: TRUSTED_IPS=192.168.1.100,192.168.1.50
TRUSTED_IPS=127.0.0.1
# Reverse proxies allowed to report the client IP (comma-separated IPs or CIDR blocks).
# Leave EMPTY unless Tradleware runs behind a reverse proxy or tunnel (nginx, Caddy,
# Traefik, Cloudflare Tunnel). Only requests coming from these addresses have their
# X-Forwarded-For / X-Real-IP / X-Forwarded-Proto headers honoured — for everyone else
# the real TCP connection address is used, so nobody can claim a trusted IP by sending
# a header. Set this to the address Tradleware sees the proxy connect from (for Docker,
# the proxy container's IP or its bridge subnet), never to a range you do not control.
# Example: TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

############################################################
# General Logging Configuration
# LOG_LEVEL controls what gets written to log files and console.
# Set to 10=DEBUG, 20=INFO, 25=SUCCESS, 30=WARNING, 40=ERROR, 50=CRITICAL
# Example: LOG_LEVEL=30  # Only WARNING and above will be logged
LOG_LEVEL=10

############################################################
# Web UI Configuration
# Set the refresh interval for log polling in milliseconds (default: 5000ms = 5 seconds)
LOG_REFRESH_INTERVAL_MS=5000

# Webhook Security Configuration
# Set a custom webhook path to protect against automated bot scans
# Default: 'webhook' (accessible at /webhook)
# Recommended: Use a random string like 'x7f9k2m4p8' (accessible at /x7f9k2m4p8)
WEBHOOK_PATH=webhook  # Example: WEBHOOK_PATH=my-secret-path-abc123

# Webhook Replay Protection
# A webhook authenticates with the api_key carried inside its body, so a captured
# request would otherwise be replayable forever, placing a real order every time.
# Signals must therefore carry a current timestamp, and an identical request body is
# never accepted twice.
#
# How far the signal's timestamp may be from this host's clock, in seconds, in either
# direction. Shorter is safer. Values below 30 are raised to 30, because ordinary
# clock drift would start rejecting valid signals.
# Requires an accurate host clock (timezone does not matter, accuracy does). On a
# Raspberry Pi especially: sudo timedatectl set-ntp true
# TradingView alerts must send {{timenow}} (the alert time), NOT {{time}} (the bar
# time) — bar time is already hours old on higher timeframes and will be rejected.
WEBHOOK_MAX_AGE_S=300
# Where accepted signals are remembered, so a restart cannot reopen the replay window.
# Defaults into the logs directory, the only path docker-compose persists.
# WEBHOOK_REPLAY_DB=/app/src/logs/webhook_replay.json

############################################################
# IBKR Health Check Configuration
# Interval (in seconds) between automatic IBKR gateway liveness probes.
# A Gotify notification is sent when a connection drops or is restored.
# Default: 60 seconds
IBKR_HEALTH_CHECK_INTERVAL_S=1800

##############################################################
# Gotify Notification Configuration
# Set these to enable real-time notifications for SUCCESS, WARNING, ERROR events
GOTIFY_SERVER_URL=https://your-gotify-server.com
GOTIFY_APP_TOKEN=your_gotify_app_token
# Default to WARNING level; adjust as needed (10=DEBUG, 20=INFO, 30=SUCCESS/WARNING, 40=ERROR, 50=CRITICAL)
GOTIFY_LOG_LEVEL=30

