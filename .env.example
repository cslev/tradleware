# .env.example — Tradleware configuration template
#
# Bot configurations (API keys, secrets, trading pairs) live in YAML files under
# bot_configs/crypto/ and bot_configs/stock/, not here. See the .yaml.example files.
#
# This file is in three parts:
#   1. SETTINGS YOU SHOULD CHANGE  — a handful, right below
#   2. OPTIONAL SETTINGS           — notifications, logging verbosity
#   3. SECURITY HARDENING          — safe to ignore; the defaults are the right answer
#
# IMPORTANT: inline comments MUST have a space before the #
#   Correct:   MYVAR="value" # comment
#   Incorrect: MYVAR="value"# the # ends up in the value


############################################################################
#  1. SETTINGS YOU SHOULD CHANGE
############################################################################

# --- Dashboard login ------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme  # Generate a strong one: openssl rand -base64 32

# --- Webhook endpoint -----------------------------------------------------
# Randomise this. Scanners probe /webhook constantly, and while the API key is what
# actually protects the endpoint, an unguessable path keeps their noise out of your
# logs and notifications. Generate one: pwgen -n 14 1   (or: openssl rand -hex 8)
WEBHOOK_PATH=webhook  # Example: WEBHOOK_PATH=ka8Moh4aiNgai4

# --- Addresses that skip the login page -----------------------------------
# Comma-separated. Meant for a keyboardless Raspberry Pi kiosk on your own network.
# Use the address Tradleware actually sees, shown in the dashboard footer: traffic from
# the Docker host arrives from the network's gateway, NOT the container's own IP.
# See the ipam note in docker-compose.yml if you want to pin that gateway.
TRUSTED_IPS=127.0.0.1


############################################################################
#  2. OPTIONAL SETTINGS
############################################################################

# --- Notifications (Gotify) -----------------------------------------------
# Leave the URL blank to disable. Levels: 10=DEBUG 20=INFO 25=SUCCESS 30=WARNING 40=ERROR
GOTIFY_SERVER_URL=https://your-gotify-server.com
GOTIFY_APP_TOKEN=your_gotify_app_token
GOTIFY_LOG_LEVEL=30

# --- Logging --------------------------------------------------------------
# 10=DEBUG 20=INFO 25=SUCCESS 30=WARNING 40=ERROR 50=CRITICAL
LOG_LEVEL=10
# Dashboard log-panel refresh, in milliseconds
LOG_REFRESH_INTERVAL_MS=5000

# --- IBKR gateway health check --------------------------------------------
# Seconds between liveness probes; a Gotify notification is sent on loss and restore
IBKR_HEALTH_CHECK_INTERVAL_S=1800

# --- Update check ---------------------------------------------------------
# Seconds between checks of the GitHub tags API for a newer release. The dashboard
# footer shows the result. Default 21600 = 6 hours.
UPDATE_CHECK_INTERVAL_S=21600


############################################################################
#  3. SECURITY HARDENING
#
#  You can stop reading here. Every setting below already has the right value
#  for a normal deployment, and none of them need tuning as you grow — a single
#  instance running many strategies across many bots is exactly what these
#  defaults were sized for. Nothing here throttles, delays or rejects a
#  correctly configured signal, however many you send.
#
#  Two exceptions, both flagged again where they appear:
#
#    * TRUSTED_PROXIES — you MUST set this if Tradleware runs behind a reverse
#      proxy or tunnel (nginx, Caddy, Traefik, Cloudflare Tunnel). Leaving it
#      empty in that setup means every webhook is rejected.
#
#    * TRADER_LOCK_TIMEOUT_S — the only default a heavy setup can outgrow.
#      Raise it if many signals hit the SAME bot at once and fills are slow.
#
#  Everything else fails safe and self-heals.
############################################################################

# --- Running behind a reverse proxy or tunnel -----------------------------
# ⚠️  REQUIRED if anything sits in front of Tradleware. Comma-separated IPs or CIDRs.
#
# Tradleware only believes X-Forwarded-For / X-Real-IP / X-Forwarded-Proto from these
# addresses. Without that, anyone could claim a trusted IP just by sending a header.
# The flip side: leave it empty while behind a proxy and Tradleware cannot tell your
# traffic arrived over TLS, so every webhook is refused with 403.
#
# Set it to the address Tradleware sees the proxy connect FROM — for Docker, the proxy
# container's IP or its bridge subnet. Never a range you do not control.
# Example: TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

# --- Webhook transport ----------------------------------------------------
# The bot's api_key travels inside the webhook body, so a cleartext delivery hands a
# working trading credential to anyone on the path. Tradleware does not terminate TLS
# itself; this works via the TLS-terminating proxy above.
# Set false ONLY when the signal source is on this host or a trusted LAN.
WEBHOOK_REQUIRE_HTTPS=true

# --- Session cookie -------------------------------------------------------
# Secure flag: browsers then never send the cookie over plain HTTP. With this on you
# cannot sign in over http:// — use HTTPS, or use TRUSTED_IPS for local access.
SESSION_HTTPS_ONLY=true
# Session lifetime in seconds (12h). These are signed cookies with no server-side
# store, so logging out cannot revoke one already copied; a short life is the bound.
SESSION_MAX_AGE_S=43200
# Leave empty and a random key is generated at each start, signing everyone out on
# restart. Set it to keep sessions across restarts: openssl rand -base64 32
SESSION_SECRET_KEY=

# --- Replay protection ----------------------------------------------------
# A captured webhook could otherwise be re-sent forever, placing a real order each
# time. Signals must carry a current timestamp and are accepted only once.
#
# ⚠️  TradingView alerts must send {{timenow}} (the alert time), NOT {{time}} (the bar
# time) — bar time is already hours old on higher timeframes and will be rejected.
# Needs an accurate host clock; timezone is irrelevant, accuracy is not. On a Pi:
#   sudo timedatectl set-ntp true
# Values below 30 are raised to 30, since ordinary drift would reject good signals.
WEBHOOK_MAX_AGE_S=300
# Where accepted signals are remembered so a restart cannot reopen the replay window.
# Defaults into the logs directory, the only path docker-compose persists.
# WEBHOOK_REPLAY_DB=/app/src/logs/webhook_replay.json

# --- Flood protection -----------------------------------------------------
# Failed authentications tolerated from ONE address per window before it gets 429.
# Counted per source, so an attacker can only throttle themselves, never your bots, and
# a successful signal clears that address at once. Loopback and TRUSTED_IPS are never
# throttled. A correctly configured source never fails, so this never touches it.
WEBHOOK_FAILURE_LIMIT=20
WEBHOOK_FAILURE_WINDOW_S=60
# Repeated rejections are collapsed into one summary line this often. The first of each
# distinct problem is always reported immediately, so nothing is hidden.
WEBHOOK_REJECTION_SUMMARY_S=300

# --- Trade execution serialisation ----------------------------------------
# Each bot executes one operation at a time, so two signals cannot both size an order
# from the same pre-trade balance and overspend. Different bots still run in parallel.
#
# ⚠️  The one default a heavy setup can outgrow. A request waits this long for the bot
# to become free, then gives up with 503 — a missed trade. Only bites when many signals
# target the SAME bot at once. Roughly, one bot needs:
#     (simultaneous signals) x (seconds per fill)  <  TRADER_LOCK_TIMEOUT_S
# Crypto market orders fill in ~1-2s, so ~30 at once is fine. IBKR polls for fills and
# can take ~5s, so past ~10 simultaneous signals on one IBKR bot, raise this.
# Queued signals do not go stale: freshness is checked on arrival, not on execution.
TRADER_LOCK_TIMEOUT_S=60

# --- Log retention --------------------------------------------------------
# The container has no external log rotation, so the file is capped here. Rotated files
# are gzipped (~8x), giving a ~16 MB ceiling from ~60 MB of raw text. The active log
# stays uncompressed for tailing; read the rest with zcat / zless / zgrep.
# Worth lowering on a small SD card, especially at LOG_LEVEL=10.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_COMPRESS_ROTATED=true
