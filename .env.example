# .env.example file - Template for environment configuration

# --- List of active configurations to load ---
# Format: ACCOUNT_IDENTIFIER_EXCHANGE_NAME (comma-separated)
# Example: ACTIVE_TRADING_CONFIGS="MYBTCBOT_OKX,MYBTC_COINBASEPRO"
ACTIVE_TRADING_CONFIGS="MYBTCBOT_OKX"

# --- Configuration for your OKX Account (e.g., named MYBTCBOT_OKX) - prefix has to match the above ACTIVE_TRADING_CONFIGS ---
MYBTCBOT_OKX_API_KEY="your_okx_api_key_here"
MYBTCBOT_OKX_SECRET_KEY="your_okx_secret_key_here"
MYBTCBOT_OKX_PASSPHRASE="your_okx_passphrase_here" #might not be needed for some regions
MYBTCBOT_OKX_HOSTNAME="my.okx.com" #modify this based on your region, maybe it's just okx.com (especially if you encounter API key does not exist error)
MYBTCBOT_OKX_SUBACCOUNT_NAME="BTCautotrade" # The actual name of your subaccount on OKX
MYBTCBOT_OKX_FIAT_STABLECOIN_PAIR="USDT/SGD" #pattern: STABLECOIN/FIAT! This will be used if no stable coin available (yet) to convert your X percent of your fiat to stablecoin first
MYBTCBOT_OKX_CRYPTO_STABLECOIN_PAIR="BTC/USDT" #this is the actual trading symbol (mostly likely coming from TradingView oso)
# generate an API key for tradleware webhooks via `openssl rand -hex 32`
MYBTCBOT_OKX_TRADLEWARE_API_KEY="your_tradleware_api_key_here"


# --- Configuration for your Coinbase Pro Account (e.g., named MYBTCBOT_COINBASEPRO) ---
# MYBTCBOT_COINBASEPRO_API_KEY="YOUR_COINBASEPRO_API_KEY"
# MYBTCBOT_COINBASEPRO_SECRET_KEY="YOUR_COINBASEPRO_SECRET_KEY"
# MYBTCBOT_COINBASEPRO_PASSPHRASE="" # Usually not needed for Coinbase Pro API keys
# MYBTCBOT_COINBASEPRO_SUBACCOUNT_NAME="" # Coinbase Pro doesn't have a direct 'subAccount' parameter in ccxt like OKX
# MYBTCBOT_OKX_FIAT_STABLECOIN_PAIR="USDT/SGD" #pattern: STABLECOIN/FIAT! This will be used if no stable coin available (yet) to convert your X percent of your fiat to stablecoin first
# MYBTCBOT_OKX_CRYPTO_STABLECOIN_PAIR="BTC/USDT" #this is the actual trading symbol (mostly likely coming from TradingView oso)
# generate an API key for tradleware webhooks via `openssl rand -hex 32`
# MYBTCBOT_OKX_TRADLEWARE_API_KEY="your_tradleware_api_key_here"


############################################################
# Gotify Notification Configuration
# Set these to enable real-time notifications for SUCCESS, WARNING, ERROR events
GOTIFY_SERVER_URL=https://your-gotify-server.com
GOTIFY_APP_TOKEN=your_gotify_app_token
GOTIFY_LOG_LEVEL=30 # Default to WARNING level; adjust as needed (10=DEBUG, 20=INFO, 30=SUCCESS/WARNING, 40=ERROR, 50=CRITICAL)

############################################################
# Web UI Configuration
# Set the refresh interval for log polling in milliseconds (default: 5000ms = 5 seconds)
LOG_REFRESH_INTERVAL_MS=1000
