# .env.example file - Template for environment configuration
#
# IMPORTANT: Inline comments (on the same line as values) MUST have a space before the #
# Correct:   MYVAR="value" # This is a comment
# Incorrect: MYVAR="value"# This will include # in the value
# Best practice: Put comments on separate lines above the configuration

# --- List of active configurations to load ---
# Format: ACCOUNT-IDENTIFIER_EXCHANGE-NAME (comma-separated)
# SUPPORTED EXCHANGES: OKX, CRYPTOCOM (exchange), IR (Independent Reserve)
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# EXCHANGE-NAMEs are fixed and MUST be incorporate into the active configs properly! 
# - OKX
# - CRYPTOCOM
# - IR   
# Example: ACTIVE_TRADING_CONFIGS="MYBTCBOT_OKX,MYETHBOT_CRYPTOCOM,TRADLEWAREBOT_IR"
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

ACTIVE_TRADING_CONFIGS="MYBTCBOT_OKX,TRADLEWAREBOT_IR,MYETHBOT_CRYPTOCOM"

# --- Configuration for your OKX Account (e.g., named MYBTCBOT_OKX) - prefix has to match the above ACTIVE_TRADING_CONFIGS ---
MYBTCBOT_OKX_API_KEY="your_okx_api_key_here"
MYBTCBOT_OKX_SECRET_KEY="your_okx_secret_key_here"
# Might not be needed for some regions
MYBTCBOT_OKX_PASSPHRASE="your_okx_passphrase_here"
# Modify this based on your region, maybe it's just okx.com (especially if you encounter API key does not exist error)
MYBTCBOT_OKX_HOSTNAME="my.okx.com"
# The actual name of your subaccount on OKX
MYBTCBOT_OKX_SUBACCOUNT_NAME="BTCautotrade" 
#pattern: STABLECOIN/FIAT! This will be used if no stable coin available (yet) to convert your X percent of your fiat to stablecoin first
MYBTCBOT_OKX_STABLECOIN_FIAT_PAIR="USDT/SGD"
#this is the actual trading symbol (mostly likely coming from TradingView oso)
MYBTCBOT_OKX_CRYPTO_STABLECOIN_PAIR="BTC/USDT"
# generate an API key for tradleware webhooks via `openssl rand -hex 32`
MYBTCBOT_OKX_TRADLEWARE_API_KEY="your_tradleware_api_key_here"

# --- Configuration for your Independent Reserve Account (e.g., named TRADLEWAREBOT_IR) ---
TRADLEWAREBOT_IR_API_KEY="your_ir_api_key_here"
TRADLEWAREBOT_IR_SECRET_KEY="your_ir_secret_key_here"
# Independent Reserve typically doesn't use passphrase/subaccounts, leave blank if not used
# TRADLEWAREBOT_IR_PASSPHRASE=""
# TRADLEWAREBOT_IR_SUBACCOUNT_NAME=""
# Optional hostname if you need a custom API host (usually not required)
TRADLEWAREBOT_IR_HOSTNAME="api.independentreserve.com"
# Pairs used by your trader like the OKX config
TRADLEWAREBOT_IR_STABLECOIN_FIAT_PAIR="USDT/SGD"
TRADLEWAREBOT_IR_CRYPTO_STABLECOIN_PAIR="ETH/USDT"
# Tradleware API key for webhooks via `openssl rand -hex 32`
TRADLEWAREBOT_IR_TRADLEWARE_API_KEY="your_tradleware_api_key_here"

# --- Configuration for your Crypto.com Account (e.g., named MYETHBOT_CRYPTOCOM) ---
MYETHBOT_CRYPTOCOM_API_KEY="your_cryptocom_api_key_here"
MYETHBOT_CRYPTOCOM_SECRET_KEY="your_cryptocom_secret_key_here"
# Crypto.com doesn't typically use passphrase
# MYETHBOT_CRYPTOCOM_PASSPHRASE=""
# The actual name of your subaccount on Crypto.com (leave blank if not using subaccounts)
MYETHBOT_CRYPTOCOM_SUBACCOUNT_NAME="ETHautotrade"
# Optional hostname if you need a custom API host (usually not required)
MYETHBOT_CRYPTOCOM_HOSTNAME="api.crypto.com"
# Pairs used by your trader
MYETHBOT_CRYPTOCOM_STABLECOIN_FIAT_PAIR="USDT/USD"
MYETHBOT_CRYPTOCOM_CRYPTO_STABLECOIN_PAIR="ETH/USDT"
# Tradleware API key for webhooks via `openssl rand -hex 32`
MYETHBOT_CRYPTOCOM_TRADLEWARE_API_KEY="your_tradleware_api_key_here"

############################################################
# Dashboard Authentication Configuration
# Credentials for accessing the web dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme  # IMPORTANT: Generate a strong password with: openssl rand -base64 32
# Session secret key for encrypting session cookies (auto-generated if not set)
SESSION_SECRET_KEY=  # Optional: Generate with: openssl rand -base64 32
# Trusted IPs that bypass authentication (comma-separated, useful for local Raspberry Pi displays)
# Example: TRUSTED_IPS=192.168.1.100,192.168.1.50
TRUSTED_IPS=127.0.0.1

############################################################
# General Logging Configuration
# LOG_LEVEL controls what gets written to log files and console.
# Set to 10=DEBUG, 20=INFO, 25=SUCCESS, 30=WARNING, 40=ERROR, 50=CRITICAL
# Example: LOG_LEVEL=30  # Only WARNING and above will be logged
LOG_LEVEL=10

############################################################
# Gotify Notification Configuration
# Set these to enable real-time notifications for SUCCESS, WARNING, ERROR events
GOTIFY_SERVER_URL=https://your-gotify-server.com
GOTIFY_APP_TOKEN=your_gotify_app_token
GOTIFY_LOG_LEVEL=30 # Default to WARNING level; adjust as needed (10=DEBUG, 20=INFO, 30=SUCCESS/WARNING, 40=ERROR, 50=CRITICAL)

############################################################
# Interactive Brokers (IBKR) Gateway Configuration
# Required only if using IBKR for stock trading
# Start gateway with: docker-compose -f docker-compose.ibkr.yml up -d

# IBKR Gateway Host (shared by all IBKR bots)
IBKR_GATEWAY_HOST=127.0.0.1

# IBKR Account Credentials
IBKR_USERNAME=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password

# Trading Mode: 'paper' or 'live'
# This determines which IBKR servers the gateway connects to
# AND which port your bots will use (paper=4002, live=4001)
IBKR_TRADING_MODE=paper

# VNC Password (for remote viewing of gateway interface)
IBKR_VNC_PASSWORD=changeme

# Read-only mode (true = no orders will be placed, just data access)
IBKR_READ_ONLY=false

# --- Configuration for IBKR Stock Bot (example: MYAPPLEBOT_IBKR) ---
# Note: Add to ACTIVE_TRADING_CONFIGS above to enable
# Gateway host and port are shared from the global IBKR settings above

# MYAPPLEBOT_IBKR_ACCOUNT_ID=U1234567  # Your IBKR account ID
# MYAPPLEBOT_IBKR_SYMBOL=AAPL  # Stock symbol to trade
# MYAPPLEBOT_IBKR_EXTENDED_HOURS=false  # Allow pre-market/after-hours trading
# MYAPPLEBOT_IBKR_FRACTIONAL_SHARES=false  # Allow fractional share quantities (e.g. 6.818 shares). Not all symbols support this — if enabled on an unsupported symbol, the order will be rejected by IBKR.
# MYAPPLEBOT_IBKR_TRADLEWARE_API_KEY=your_unique_webhook_key  # For webhook authentication

