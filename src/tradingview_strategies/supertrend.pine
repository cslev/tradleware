//@version=6
strategy("copilot - Supertrend", overlay=true, commission_type=strategy.commission.percent, commission_value=0.1, slippage=3, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Date filters (use literal Unix timestamps for const int)
startDate = input.time(1514764800000, "Start Date")  // 2018-01-01 00:00 UTC
endDate   = input.time(3155673599000, "End Date")    // 2069-12-31 23:59 UTC
inRange   = time >= startDate and time <= endDate

// Supertrend parameters
atrPeriod = input.int(10, "ATR Period", minval=1)
atrMultiplier = input.float(3.0, "ATR Multiplier", minval=0.1, step=0.1)

// Calculate ATR
atr = ta.atr(atrPeriod)

// Calculate basic upper and lower bands
hl2Value = hl2
upperBand = hl2Value + (atrMultiplier * atr)
lowerBand = hl2Value - (atrMultiplier * atr)

// Calculate final bands (trend-following logic)
var float finalUpperBand = na
var float finalLowerBand = na

finalUpperBand := upperBand < finalUpperBand[1] or close[1] > finalUpperBand[1] ? upperBand : finalUpperBand[1]
finalLowerBand := lowerBand > finalLowerBand[1] or close[1] < finalLowerBand[1] ? lowerBand : finalLowerBand[1]

// Determine trend direction
var int supertrend = 1
supertrend := close <= finalUpperBand ? 1 : close >= finalLowerBand ? -1 : supertrend[1]

// Determine which band to plot
supertrendLine = supertrend == 1 ? finalUpperBand : finalLowerBand

// Plot Supertrend with color based on trend
plot(supertrendLine, title="Supertrend", color=supertrend == 1 ? color.red : color.green, linewidth=2)

// Detect trend changes for trading signals
trendUp = supertrend == -1 and supertrend[1] == 1
trendDown = supertrend == 1 and supertrend[1] == -1

// Trading rules: Long-only using Supertrend signals
if inRange
    // Enter long when trend flips to bullish (from red to green)
    if trendUp and strategy.position_size == 0
        strategy.entry("Long", strategy.long)
    // Exit when trend flips to bearish (from green to red)
    if trendDown and strategy.position_size > 0
        strategy.close("Long")