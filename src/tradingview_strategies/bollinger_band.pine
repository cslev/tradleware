//@version=6
strategy("copilot - Bollinger Bands", overlay=true, commission_type=strategy.commission.percent, commission_value=0.1, slippage=3, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Date filters (use literal Unix timestamps for const int)
startDate = input.time(1514764800000, "Start Date")  // 2018-01-01 00:00 UTC
endDate   = input.time(3155673599000, "End Date")    // 2069-12-31 23:59 UTC
inRange   = time >= startDate and time <= endDate

length = input.int(20, minval=1)
maType = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
src = input(close, title="Source")
mult = input.float(2.0, minval=0.001, maxval=50, title="StdDev")

ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

basis = ma(src, length, maType)
dev = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
offset = input.int(0, "Offset", minval = -500, maxval = 500, display = display.data_window)
plot(basis, "Basis", color=#2962FF, offset = offset)
p1 = plot(upper, "Upper", color=#F23645, offset = offset)
p2 = plot(lower, "Lower", color=#089981, offset = offset)
fill(p1, p2, title = "Background", color=color.rgb(33, 150, 243, 95))

// Trading rules: Long-only using Bollinger signals
// Use crossover/crossunder to avoid repainting and ensure clean entry/exit
if inRange
    // Enter long when close crosses above upper band
    if ta.crossover(close, upper) and strategy.position_size == 0
        strategy.entry("Long", strategy.long)
    // Exit when close crosses below lower band
    if ta.crossunder(close, lower) and strategy.position_size > 0
        strategy.close("Long")