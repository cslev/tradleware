# IB Gateway Docker container credentials
# Copy this file to .env.ibkr and fill in your values.
# This file is only used by docker-compose.ibkr.yml to configure the IB Gateway container.
# Tradleware itself does not read these — it only connects to the gateway via host:port in ibkr.yaml.
# Never commit .env.ibkr — it contains your IBKR account credentials.

# Your IBKR login credentials
USERNAME=your_ibkr_username
PASSWORD=your_ibkr_password

# Trading mode: 'paper' or 'live'
IBC_TradingMode=paper

# Read-only API mode: 'yes' = no orders will be placed (safer for testing)
IBC_ReadOnlyApi=no
