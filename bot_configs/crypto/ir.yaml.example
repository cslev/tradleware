# Independent Reserve Bot Configurations
# ---------------------------------------------------------------
# Add one entry per bot under the `bots:` key.
# Each bot id must be unique, lowercase, alphanumeric + underscores only.
# The id is used as the trader_id in webhook payloads.
#
# File permissions: chmod 600 bot_configs/crypto/ir.yaml
# ---------------------------------------------------------------

bots:
  - id: mypepebot_ir                      # Used as trader_id in webhook payloads
    api_key: "your_api_key_here"
    secret_key: "your_secret_key_here"
    hostname: "api.independentreserve.com"  # IR does not use passphrases
    stablecoin_fiat_pair: "SGD/SGD"       # IR trades directly in fiat (e.g. SGD/SGD, AUD/AUD)
    crypto_stablecoin_pair: "PEPE/SGD"    # e.g. BTC/SGD, ETH/AUD
    tradleware_api_key: "your_tradleware_api_key_here"  # Webhook auth key — generate with: openssl rand -hex 32
