# Coinbase (Advanced Trade / CDP) Bot Configurations
# ---------------------------------------------------------------
# Add one entry per bot under the `bots:` key.
# Each bot id must be unique, lowercase, alphanumeric + underscores only.
# The id is used as the trader_id in webhook payloads.
#
# Authentication: Coinbase uses CDP (Coinbase Developer Platform) API keys.
# - api_key:    Copy the `name` field from your downloaded CDP JSON key file.
#               Format: organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID
# - secret_key: Copy the `privateKey` field from the same JSON file.
#               The key is an EC private key — preserve the \n newlines exactly.
#
# CCXT detects CDP keys automatically (apiKey contains "organizations/" or
# secret starts with "-----BEGIN") and handles JWT signing internally.
# No passphrase needed for Coinbase.
#
# File permissions: chmod 600 bot_configs/crypto/coinbase.yaml
# ---------------------------------------------------------------

bots:
  - id: mydogebot                                   # Used as trader_id in webhook payloads
    api_key: "organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID"
    secret_key: "-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END EC PRIVATE KEY-----\n"
    hostname: "api.coinbase.com"                    # Coinbase Advanced Trade API endpoint
    stablecoin_fiat_pair: "USDT/USD"               # to convert your fiat to stablecoin if needed
    crypto_stablecoin_pair: "DOGE/USDT"            # the trading pair, e.g. BTC/USD, ETH/USDT
    tradleware_api_key: "your_tradleware_api_key_here"  # Webhook auth key — generate with: openssl rand -hex 32
    # subaccount_name: "My DOGE Bot"               # Optional display label for the dashboard bot card.
    #                                               # Coinbase does NOT support subaccounts via the API —
    #                                               # this field has no effect on trading or authentication.
    #                                               # Use it purely to override the header text shown in the UI.
